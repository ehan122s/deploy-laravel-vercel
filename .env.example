# =================================================================
# BRILINK MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# =================================================================

# 1. Database Connection (PostgreSQL)
# For local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brilink_db?schema=public"

# For Vercel production deployment:
# You can use free hosted PostgreSQL from:
# - Neon.tech: postgresql://username:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql://postgres.xyz:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# - Vercel Postgres: Automatically injected when you connect a Vercel Postgres database

# 2. Authentication Secret (JWT Encryption)
# Generate a random 32+ char string (e.g. openssl rand -base64 32)
AUTH_SECRET="brilink-super-secret-jwt-key-production-change-this-2026"

# 3. Application URL (Production Domain)
NEXTAUTH_URL="https://your-project-name.vercel.app"

# 4. App Branding
NEXT_PUBLIC_APP_NAME="BRILink Management"
NEXT_PUBLIC_COMPANY_NAME="PT Bank Rakyat Indonesia (Persero) Tbk - Agen BRILink"
